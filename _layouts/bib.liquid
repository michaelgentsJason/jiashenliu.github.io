---
---
<article class="paper" id="{{ entry.key }}">
  <h4 class="paper-title">{{ entry.title }}</h4>
  <div class="paper-authors">
    {% for author in entry.author_array %}
      {% unless forloop.first %}, {% endunless %}
      {% if author.last == 'others' %}et al.{% elsif author.last == 'Liu' and author.first == 'J.' %}<strong>J. Liu</strong>{% else %}{{ author.first }} {{ author.last }}{% endif %}
    {% endfor %}
  </div>
  <p class="paper-venue">{{ entry.venue_display }} <span class="paper-year">· {{ entry.year }}</span></p>
  {% if entry.contribution %}<p class="paper-note">{{ entry.contribution }}</p>{% endif %}
  {% if entry.html or entry.pdf or entry.doi %}
    <div class="paper-links">
      {% if entry.html %}<a href="{{ entry.html }}" target="_blank" rel="noopener noreferrer">arXiv <span aria-hidden="true">↗</span></a>{% endif %}
      {% if entry.pdf %}<a href="{{ entry.pdf }}" target="_blank" rel="noopener noreferrer">PDF <span aria-hidden="true">↗</span></a>{% endif %}
      {% if entry.doi %}<a href="https://doi.org/{{ entry.doi }}" target="_blank" rel="noopener noreferrer">Paper <span aria-hidden="true">↗</span></a>{% endif %}
    </div>
  {% endif %}
</article>
